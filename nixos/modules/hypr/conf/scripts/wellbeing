#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hypr/wellbeing"
SECONDS_FILE="$STATE_DIR/seconds"
ACTIVITY_FILE="$STATE_DIR/activity"
ALERT_FILE="$STATE_DIR/alert"
IDLE_SINCE_FILE="$STATE_DIR/idle_since"
REMINDER_COUNT_FILE="$STATE_DIR/reminder_count"
LAST_REMINDER_FILE="$STATE_DIR/last_reminder"
PID_FILE="$STATE_DIR/wellbeing.pid"
LOG_FILE="$STATE_DIR/log"

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/wellbeing.yml"

# Read a value from CONFIG_FILE using yq. Falls back to $2 if the file or key is missing.
read_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "$2"
        return
    fi

    local value
    value=$(yq "$1" "$CONFIG_FILE" 2>/dev/null || true)

    if [[ -z "$value" || "$value" == "null" || "$value" == "~" ]]; then
        echo "$2"
    else
        echo "$value"
    fi
}

BREAK_SECS=$(read_config '.timers.break_secs' '3600')
LONG_IDLE_SECS=$(read_config '.timers.long_idle_secs' '300')
REMINDER_BASE=$(read_config '.reminders.base' '300')
REMINDER_REDUCTION=$(read_config '.reminders.reduction' '30')
REMINDER_MIN=$(read_config '.reminders.min' '30')
LOG_MAX_LINES=$(read_config '.log.max_lines' '200')
ALERT_SOUND=$(read_config '.notifications.alert_sound' '/usr/share/sounds/freedesktop/stereo/message-new-instant.oga')
APP_NAME=$(read_config '.notifications.app_name' 'Wellbeing')
ICON_IDLE=$(read_config '.icons.idle' ' 󰒲 ')
ICON_ALERT=$(read_config '.icons.alert' ' 󰅶  ')

mkdir -p "$STATE_DIR"

play_alert_sound() {
    if [[ -n "$ALERT_SOUND" ]] && [[ -f "$ALERT_SOUND" ]]; then
        paplay "$ALERT_SOUND" 2>/dev/null || true
    fi
}

ensure_state() {
    [[ -f "$SECONDS_FILE" ]] || echo 0 >"$SECONDS_FILE"
    [[ -f "$ACTIVITY_FILE" ]] || echo "active" >"$ACTIVITY_FILE"
    [[ -f "$ALERT_FILE" ]] || echo 0 >"$ALERT_FILE"
    [[ -f "$REMINDER_COUNT_FILE" ]] || echo 0 >"$REMINDER_COUNT_FILE"
    [[ -f "$IDLE_SINCE_FILE" ]] || rm -f "$IDLE_SINCE_FILE"
    [[ -f "$LAST_REMINDER_FILE" ]] || rm -f "$LAST_REMINDER_FILE"
}

log_msg() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE"
    if [[ $(wc -l <"$LOG_FILE" 2>/dev/null || echo 0) -gt $LOG_MAX_LINES ]]; then
        tail -n "$LOG_MAX_LINES" "$LOG_FILE" >"$LOG_FILE.tmp"
        mv "$LOG_FILE.tmp" "$LOG_FILE"
    fi
}

daemon_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

epoch_now() {
    date +%s
}

format_time() {
    local total="$1"
    local h=$((total / 3600))
    local m=$(((total % 3600) / 60))
    local s=$((total % 60))

    if ((h > 0)); then
        printf "%dh %02dm %02ds" "$h" "$m" "$s"
    else
        printf "%dm %02ds" "$m" "$s"
    fi
}

next_reminder_interval() {
    local count="${1:-0}"
    local interval=$((REMINDER_BASE - count * REMINDER_REDUCTION))
    if ((interval < REMINDER_MIN)); then
        echo "$REMINDER_MIN"
    else
        echo "$interval"
    fi
}

compose_reminder_message() {
    local count="${1:-0}"
    local seconds="$2"

    case "$count" in
    0)
        printf '%s\n%s' \
            "Time for a break" \
            "You have been active for $(format_time "$seconds"). Step away for a while."
        ;;
    1)
        printf '%s\n%s' \
            "Break reminder" \
            "You have been active for $(format_time "$seconds"). Please take a break."
        ;;
    2)
        printf '%s\n%s' \
            "Still going" \
            "You have been active for $(format_time "$seconds"). Step away from the screen."
        ;;
    *)
        printf '%s\n%s' \
            "⚠️ Take a break now" \
            "This is reminder #$count. You have been active for $(format_time "$seconds")."
        ;;
    esac
}

send_break_reminder() {
    local count="$1"
    local seconds="$2"
    local title body

    mapfile -t message < <(compose_reminder_message "$count" "$seconds")
    title="${message[0]}"
    body="${message[1]}"

    notify-send \
        -a "$APP_NAME" \
        -u normal \
        -i preferences-system-notifications \
        "$title" \
        "$body"
    play_alert_sound
    log_msg "break reminder #$count sent at $(format_time "$seconds")"
}

clear_reminder_state() {
    echo 0 >"$REMINDER_COUNT_FILE"
    rm -f "$LAST_REMINDER_FILE"
}

reset_timer() {
    echo 0 >"$SECONDS_FILE"
    echo 0 >"$ALERT_FILE"
    rm -f "$IDLE_SINCE_FILE"
    clear_reminder_state
    echo "active" >"$ACTIVITY_FILE"
}

cmd_daemon() {
    if daemon_running; then
        echo "wellbeing daemon already running (pid $(cat "$PID_FILE"))" >&2
        log_msg "daemon already running (pid $(cat "$PID_FILE"))"
        exit 0
    fi

    ensure_state

    local seconds alert
    seconds=$(cat "$SECONDS_FILE" 2>/dev/null || echo 0)
    alert=$(cat "$ALERT_FILE" 2>/dev/null || echo 0)

    # Reset stale alert/reminder state if the timer is below the threshold.
    if ((alert == 1)) && ((seconds < BREAK_SECS)); then
        echo 0 >"$ALERT_FILE"
        clear_reminder_state
        alert=0
        log_msg "alert/reminder state reset because seconds ($seconds) below threshold ($BREAK_SECS)"
    fi

    # Write pidfile
    echo $$ >"$PID_FILE"

    # Clean up pidfile on exit
    trap 'rm -f "$PID_FILE"' EXIT

    # Ensure 'active' is the default if something wipes the file
    echo "active" >"$ACTIVITY_FILE"

    log_msg "daemon started (pid $$, break ${BREAK_SECS}s, long-idle ${LONG_IDLE_SECS}s, reminder base ${REMINDER_BASE}s, current seconds $seconds)"

    while true; do
        sleep 1

        local activity
        activity=$(cat "$ACTIVITY_FILE" 2>/dev/null || echo "active")

        if [[ "$activity" == "idle" ]]; then
            # Record when idle started, if not already recorded.
            if [[ ! -f "$IDLE_SINCE_FILE" ]]; then
                epoch_now >"$IDLE_SINCE_FILE"
                log_msg "idle started"
            fi
            continue
        fi

        # Returning from idle.
        if [[ -f "$IDLE_SINCE_FILE" ]]; then
            local idle_since idle_duration
            idle_since=$(cat "$IDLE_SINCE_FILE")
            idle_duration=$(($(epoch_now) - idle_since))
            rm -f "$IDLE_SINCE_FILE"

            if ((idle_duration >= LONG_IDLE_SECS)); then
                reset_timer
                log_msg "resumed after long idle ($(format_time "$idle_duration")); session reset"
                notify-send \
                    -a "$APP_NAME" \
                    -u normal \
                    -i preferences-system-notifications \
                    "Work session reset" \
                    "Idle for $(format_time "$idle_duration"). Starting a fresh session."
                play_alert_sound
                continue
            else
                log_msg "resumed after short idle ($(format_time "$idle_duration")); timer resumed"
            fi
        fi

        seconds=$(cat "$SECONDS_FILE" 2>/dev/null || echo 0)
        alert=$(cat "$ALERT_FILE" 2>/dev/null || echo 0)

        seconds=$((seconds + 1))
        echo "$seconds" >"$SECONDS_FILE"

        if ((seconds >= BREAK_SECS)); then
            if ((alert == 0)); then
                echo 1 >"$ALERT_FILE"
                clear_reminder_state
                log_msg "break threshold reached at $seconds seconds"
            fi

            local reminder_count current_interval last_reminder now elapsed
            reminder_count=$(cat "$REMINDER_COUNT_FILE" 2>/dev/null || echo 0)
            current_interval=$(next_reminder_interval "$reminder_count")
            now=$(epoch_now)

            if [[ -f "$LAST_REMINDER_FILE" ]]; then
                last_reminder=$(cat "$LAST_REMINDER_FILE")
                elapsed=$((now - last_reminder))
            else
                # First reminder at the break threshold fires immediately.
                elapsed=$current_interval
            fi

            if ((elapsed >= current_interval)); then
                send_break_reminder "$reminder_count" "$seconds"
                echo "$((reminder_count + 1))" >"$REMINDER_COUNT_FILE"
                echo "$now" >"$LAST_REMINDER_FILE"
            fi
        else
            # Below threshold: ensure reminder state is clean.
            if ((alert == 1)); then
                echo 0 >"$ALERT_FILE"
                clear_reminder_state
                log_msg "cleared alert/reminder state below threshold"
            fi
        fi
    done
}

cmd_restart() {
    log_msg "restart requested"
    if daemon_running; then
        local pid
        pid=$(cat "$PID_FILE")
        log_msg "stopping existing daemon (pid $pid)"
        kill "$pid" 2>/dev/null || true
        rm -f "$PID_FILE"
        sleep 0.2
    fi
    cmd_daemon
}

cmd_print() {
    ensure_state

    local seconds alert activity idle_class tooltip_text
    seconds=$(cat "$SECONDS_FILE" 2>/dev/null || echo 0)
    alert=$(cat "$ALERT_FILE" 2>/dev/null || echo 0)
    activity=$(cat "$ACTIVITY_FILE" 2>/dev/null || echo "active")
    idle_class=""
    tooltip_text=""

    # Compute idle class and tooltip while idle.
    if [[ "$activity" == "idle" ]]; then
        local idle_since idle_duration
        idle_duration=0
        if [[ -f "$IDLE_SINCE_FILE" ]]; then
            idle_since=$(cat "$IDLE_SINCE_FILE")
            idle_duration=$(($(epoch_now) - idle_since))
        fi

        if ((idle_duration >= LONG_IDLE_SECS)); then
            idle_class="idle-long"
            tooltip_text="Idle for $(format_time "$idle_duration"). Timer will reset when you return."
        else
            idle_class="idle"
            tooltip_text="Idle for $(format_time "$idle_duration"). Timer will resume when you return."
        fi
    fi

    local text class tooltip reminder_count reminder_interval

    if ((alert == 1)) || ((seconds >= BREAK_SECS)); then
        reminder_count=$(cat "$REMINDER_COUNT_FILE" 2>/dev/null || echo 0)
        reminder_interval=$(next_reminder_interval "$reminder_count")
        text="${ICON_ALERT}$(format_time "$seconds") break!"
        class="alert"
        tooltip="Active for $(format_time "$seconds"). Reminder #$reminder_count sent. Next reminder in up to $(format_time "$reminder_interval"). Click to reset."
    elif [[ "$activity" == "idle" ]]; then
        text="${ICON_IDLE}"
        class="$idle_class"
        tooltip="$tooltip_text"
    else
        text="$(format_time "$seconds")"
        class=""
        tooltip="Active time this session. Click to reset. Break reminder at $(format_time "$BREAK_SECS")."
    fi

    # Waybar expects a single line of JSON
    printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$text" "$class" "$tooltip"
}

cmd_reset() {
    ensure_state
    reset_timer
    log_msg "timer reset"
    echo "wellbeing timer reset"
}

cmd_help() {
    cat <<EOF
Usage: $0 [--daemon|--restart|--print|--reset]

Tracks active computer usage and reminds you to take a break.

  --daemon   Start the background tracker.
  --restart  Restart the background tracker, preserving timer state.
  --print    Output Waybar JSON for the current state.
  --reset    Reset elapsed time, alert flag, and idle state.

Configuration is read from:
  $CONFIG_FILE
Edit that YAML file to change timers, reminder schedule, sounds, and icons.
EOF
}

case "${1:-}" in
--daemon) cmd_daemon ;;
--restart) cmd_restart ;;
--print) cmd_print ;;
--reset) cmd_reset ;;
-h | --help | help) cmd_help ;;
*)
    echo "Unknown command: ${1:-}" >&2
    cmd_help >&2
    exit 1
    ;;
esac
