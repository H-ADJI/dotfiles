                "conditions": [
                  {
                    "type": "frontmost_application_unless",
                    "bundle_identifiers": [
                      "^com\\.mitchellh\\.ghostty$",
                      "^com\\.apple\\.Terminal$",
                      "^com\\.googlecode\\.iterm2$"
                    ]
                  }
                ]
              },
              {
                "description": "Ctrl+A → Cmd+A",
                "type": "basic",
                "from": {
                  "key_code": "a",
                  "modifiers": { "mandatory": ["control"], "optional": ["caps_lock"] }
